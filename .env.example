APP_NAME=OpenShop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=openshop_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
# sync: email đơn hàng gửi ngay trong request (không cần worker).
# database: email vào hàng đợi; chạy thêm "php artisan queue:work" ở Terminal khác.
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
LOG_LEVEL=debug
FILESYSTEM_DISK=local

# Email thông báo đơn hàng. Mặc định LOG (ghi log, chưa gửi thật).
# Để gửi Gmail: đổi MAIL_MAILER=smtp và nhập App Password vào MAIL_PASSWORD,
# bật xác minh 2 bước của Google trước. KHÔNG dùng mật khẩu Gmail chính.
# Không bao giờ đưa mật khẩu ứng dụng lên GitHub hoặc gửi qua chat.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=toantoan482005@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=toantoan482005@gmail.com
MAIL_FROM_NAME="OpenShop"
MAIL_TIMEOUT=15

# Chỉ cho demo local: tự đặt tài khoản Admin và mật khẩu mạnh (>= 12 ký tự).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
